# Copy to .env and fill in. Never commit .env or the service account JSON.

# Path to the service account key downloaded from
# Firebase console -> Project settings -> Service accounts -> Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Realtime Database URL, no trailing slash
FIREBASE_DB_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app

DEVICE_ID=esp32_01
PORT=5000
# Hours of history the ML insights use
ML_WINDOW_HOURS=48
